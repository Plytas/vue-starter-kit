#!/usr/bin/env php
<?php

/**
 * Show the next pending upstream PR to backport
 *
 * Usage: ./next-backport
 *
 * Shows the lowest-numbered pending PR (earliest upstream merge date),
 * which is the natural next candidate for backporting.
 */

$stateFile = __DIR__ . '/../upstream-sync.json';
if (!file_exists($stateFile)) {
    echo "Error: State file not found: {$stateFile}\n";
    exit(1);
}

$state = json_decode(file_get_contents($stateFile), true);
if (!$state) {
    echo "Error: Failed to parse state file\n";
    exit(1);
}

$pending = array_filter($state['prs'], fn($pr) => $pr['status'] === 'pending');

if (empty($pending)) {
    echo "No pending PRs — all caught up!\n";
    exit(0);
}

// Sort by upstreamMergedAt ascending (oldest first = natural backport order)
uasort($pending, function ($a, $b) {
    return strcmp($a['upstreamMergedAt'] ?? '', $b['upstreamMergedAt'] ?? '');
});

$prNumber = array_key_first($pending);
$pr = $pending[$prNumber];

$totalPending = count($pending);

echo "Next Pending PR to Backport\n";
echo str_repeat("=", 80) . "\n\n";
echo "Upstream:   #{$prNumber} — {$pr['title']}\n";
echo "Merged at:  {$pr['upstreamMergedAt']}\n";
echo "URL:        {$pr['url']}\n";

if (!empty($pr['adaptationNotes'])) {
    echo "Notes:      {$pr['adaptationNotes']}\n";
}

if (!empty($pr['confidence'])) {
    echo "Confidence: {$pr['confidence']}\n";
}

if (!empty($pr['reason'])) {
    echo "Reason:     {$pr['reason']}\n";
}

echo "\n{$totalPending} pending PR(s) remaining.\n\n";
