#!/usr/bin/env php
<?php

/**
 * Show the latest backported upstream PR
 *
 * Usage: ./latest-backport
 */

$stateFile = __DIR__ . '/../upstream-sync.json';
if (!file_exists($stateFile)) {
    echo "Error: State file not found: {$stateFile}\n";
    exit(1);
}

$state = json_decode(file_get_contents($stateFile), true);
if (!$state) {
    echo "Error: Failed to parse state file\n";
    exit(1);
}

$backported = array_filter($state['prs'], fn($pr) => $pr['status'] === 'backported');

if (empty($backported)) {
    echo "No backported PRs found.\n";
    exit(0);
}

// Sort by backportedAt descending
uasort($backported, function ($a, $b) {
    return strcmp($b['backportedAt'] ?? '', $a['backportedAt'] ?? '');
});

$prNumber = array_key_first($backported);
$pr = $backported[$prNumber];

echo "Latest Backported PR\n";
echo str_repeat("=", 80) . "\n\n";
echo "Upstream:    #{$prNumber} — {$pr['title']}\n";
echo "Upstream PR: {$pr['url']}\n";
echo "Fork PR:     {$pr['forkPR']}\n";
echo "Backported:  {$pr['backportedAt']}\n";

if (!empty($pr['adaptationNotes'])) {
    echo "Notes:       {$pr['adaptationNotes']}\n";
}

if (!empty($pr['downstreamPrs'])) {
    echo "\nDownstream propagations:\n";
    foreach ($pr['downstreamPrs'] as $repoId => $downstream) {
        if ($downstream['status'] === 'skipped') {
            echo "  {$repoId}: skipped — {$downstream['reason']}\n";
        } else {
            $status = $downstream['status'];
            $number = $downstream['number'];
            $url = $downstream['url'] ?? '';
            echo "  {$repoId}: #{$number} ({$status}) {$url}\n";
        }
    }
}

echo "\n";
