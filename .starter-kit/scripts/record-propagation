#!/usr/bin/env php
<?php

/**
 * Record a downstream propagation in upstream-sync.json
 *
 * Usage: ./record-propagation <upstream-pr-number> <downstream-repo-id> <downstream-pr-number> [status]
 * Example: ./record-propagation 158 idle-rpg 1 open
 */

if ($argc < 4) {
    echo "Usage: {$argv[0]} <upstream-pr-number> <downstream-repo-id> <downstream-pr-number> [status]\n";
    echo "Example: {$argv[0]} 158 idle-rpg 1 open\n";
    exit(1);
}

$upstreamPrNumber = $argv[1];
$downstreamRepoId = $argv[2];
$downstreamPrNumber = (int) $argv[3];
$status = $argv[4] ?? 'open';

// Validate status
if (!in_array($status, ['open', 'merged'])) {
    echo "Error: Invalid status '{$status}'. Must be 'open' or 'merged'\n";
    exit(1);
}

// Load state file
$stateFile = __DIR__ . '/../upstream-sync.json';
if (!file_exists($stateFile)) {
    echo "Error: State file not found: {$stateFile}\n";
    exit(1);
}

$state = json_decode(file_get_contents($stateFile), true);
if (!$state) {
    echo "Error: Failed to parse state file\n";
    exit(1);
}

// Validate upstream PR exists
if (!isset($state['prs'][$upstreamPrNumber])) {
    echo "Error: Upstream PR #{$upstreamPrNumber} not found in state file\n";
    exit(1);
}

// Validate downstream repo exists
$repoExists = false;
foreach ($state['downstreamRepos'] as $repo) {
    if ($repo['id'] === $downstreamRepoId) {
        $repoExists = true;
        break;
    }
}

if (!$repoExists) {
    echo "Error: Downstream repo '{$downstreamRepoId}' not found. Add it first with add-downstream-repo\n";
    exit(1);
}

// Initialize downstreamPrs if not exists
if (!isset($state['prs'][$upstreamPrNumber]['downstreamPrs'])) {
    $state['prs'][$upstreamPrNumber]['downstreamPrs'] = [];
}

// Try to get the PR URL from GitHub
$repoPath = null;
foreach ($state['downstreamRepos'] as $repo) {
    if ($repo['id'] === $downstreamRepoId) {
        $repoPath = $repo['path'];
        break;
    }
}

$prUrl = null;
if ($repoPath) {
    $remoteUrl = trim(shell_exec("git -C " . escapeshellarg($repoPath) . " remote get-url origin 2>/dev/null"));

    // Parse GitHub URL (supports both SSH and HTTPS)
    if (preg_match('#github\.com[:/]([^/]+)/([^/.]+)#', $remoteUrl, $matches)) {
        $owner = $matches[1];
        $repo = $matches[2];
        $prUrl = "https://github.com/{$owner}/{$repo}/pull/{$downstreamPrNumber}";
    }
}

// Record the propagation
$state['prs'][$upstreamPrNumber]['downstreamPrs'][$downstreamRepoId] = [
    'number' => $downstreamPrNumber,
    'status' => $status,
    'propagatedAt' => date('c')
];

if ($prUrl) {
    $state['prs'][$upstreamPrNumber]['downstreamPrs'][$downstreamRepoId]['url'] = $prUrl;
}

// Save state file
file_put_contents($stateFile, json_encode($state, JSON_PRETTY_PRINT | JSON_UNESCAPED_SLASHES) . "\n");

echo "✓ Recorded propagation of upstream PR #{$upstreamPrNumber} to {$downstreamRepoId} PR #{$downstreamPrNumber}\n";
if ($prUrl) {
    echo "✓ PR URL: {$prUrl}\n";
}
echo "✓ State file updated: {$stateFile}\n";
