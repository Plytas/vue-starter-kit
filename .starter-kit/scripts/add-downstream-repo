#!/usr/bin/env php
<?php

/**
 * Add a downstream repository to upstream-sync.json (schema v2)
 *
 * Usage: ./add-downstream-repo <repo-id> <path> [--target=start|start-teams]
 * Example: ./add-downstream-repo idle-rpg /Users/vytas/Code/idle-rpg
 * Example: ./add-downstream-repo teams-app /path/to/app --target=start-teams
 */

const SUPPORTED_TARGETS = ['start', 'start-teams'];

if ($argc < 3) {
    echo "Usage: {$argv[0]} <repo-id> <path> [--target=start|start-teams]\n";
    echo "Example: {$argv[0]} idle-rpg /Users/vytas/Code/idle-rpg\n";
    exit(1);
}

$repoId   = $argv[1];
$repoPath = $argv[2];
$target   = 'start';

foreach (array_slice($argv, 3) as $arg) {
    if (str_starts_with($arg, '--target=')) {
        $target = substr($arg, 9);
    }
}

if (!in_array($target, SUPPORTED_TARGETS, true)) {
    echo "Error: Invalid --target '{$target}'. Valid: " . implode(', ', SUPPORTED_TARGETS) . "\n";
    exit(1);
}

if (!is_dir($repoPath)) {
    echo "Error: Path does not exist: {$repoPath}\n";
    exit(1);
}

$gitDir = shell_exec("git -C " . escapeshellarg($repoPath) . " rev-parse --git-dir 2>&1");
if (strpos($gitDir, '.git') === false) {
    echo "Error: Path is not a git repository: {$repoPath}\n";
    exit(1);
}

$stateFile = getenv('SYNC_STATE_FILE') ?: __DIR__ . '/../upstream-sync.json';
if (!file_exists($stateFile)) {
    echo "Error: State file not found: {$stateFile}\n";
    exit(1);
}

$state = json_decode(file_get_contents($stateFile), true);
if (!$state) {
    echo "Error: Failed to parse state file\n";
    exit(1);
}

if (($state['version'] ?? 0) !== 2) {
    echo "Error: State file is schema v" . ($state['version'] ?? 0) . "; expected v2. Run: php sync.php migrate\n";
    exit(2);
}

foreach ($state['downstreamRepos'] as $repo) {
    if ($repo['id'] === $repoId) {
        echo "Error: Downstream repo '{$repoId}' already exists\n";
        exit(1);
    }
}

$state['downstreamRepos'][] = [
    'id'           => $repoId,
    'path'         => $repoPath,
    'status'       => 'active',
    'tracksBranch' => $target,
];

usort($state['downstreamRepos'], fn($a, $b) => strcmp($a['id'], $b['id']));

$tmp = $stateFile . '.tmp';
file_put_contents($tmp, json_encode($state, JSON_PRETTY_PRINT | JSON_UNESCAPED_SLASHES | JSON_UNESCAPED_UNICODE) . "\n");
rename($tmp, $stateFile);

echo "✓ Added downstream repo '{$repoId}' at {$repoPath} (tracksBranch: {$target})\n";
echo "✓ State file updated: {$stateFile}\n";
